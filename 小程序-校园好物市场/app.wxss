page {
  background: #fff7f2;
  font-size: 28rpx;
  color: #333;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 69, 0.08);
}
.btn-primary {
  background: linear-gradient(135deg, #FF9A44, #FF7A45);
  color: #fff;
  border-radius: 44rpx;
  font-weight: 600;
}
.btn-primary::after { border: none; }
.ghost-btn {
  background: #fff;
  color: #666;
  border: 1rpx solid #e5e5e5;
  border-radius: 44rpx;
}
.ghost-btn::after { border: none; }
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fff3ec;
  color: #FF7A45;
}
.price { color: #FF6B35; font-weight: 700; }
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #bbb;
  font-size: 26rpx;
}
.hairline { border-bottom: 1rpx solid #f0f0f0; }
