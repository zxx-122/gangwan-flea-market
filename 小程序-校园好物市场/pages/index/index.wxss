.page { padding-bottom: 40rpx; }
.header { padding: 30rpx 30rpx 10rpx; }
.hello { font-size: 34rpx; font-weight: 700; color: #333; }
.search-bar { display: flex; align-items: center; margin: 20rpx 30rpx; background: #fff; border-radius: 40rpx; padding: 8rpx 8rpx 8rpx 30rpx; box-shadow: 0 4rpx 14rpx rgba(255,122,69,.08); }
.search-bar input { flex: 1; font-size: 26rpx; }
.search-btn { background: linear-gradient(135deg, #FF9A44, #FF7A45); color: #fff; font-size: 26rpx; padding: 12rpx 34rpx; border-radius: 40rpx; }
.notice { display: flex; align-items: center; margin: 0 30rpx; background: #fff; border: 1rpx solid #ffd9b8; border-radius: 16rpx; padding: 14rpx 20rpx; }
.notice-icon { margin-right: 10rpx; }
.notice-text { flex: 1; font-size: 24rpx; color: #8a5a2b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice-close { color: #ccc; padding-left: 12rpx; }
.cat-scroll { white-space: nowrap; margin-top: 20rpx; }
.cat-row { display: inline-flex; padding: 0 20rpx; }
.cat-chip { display: inline-block; padding: 10rpx 28rpx; margin-right: 14rpx; background: #fff; border-radius: 999rpx; font-size: 26rpx; color: #666; }
.cat-chip.on { background: linear-gradient(135deg, #FF9A44, #FF7A45); color: #fff; font-weight: 600; }
.sort-row { display: flex; padding: 16rpx 30rpx 0; }
.sort-chip { margin-right: 20rpx; font-size: 26rpx; color: #999; padding: 6rpx 8rpx; }
.sort-chip.on { color: #FF7A45; font-weight: 700; border-bottom: 4rpx solid #FF7A45; }
.goods-list { display: flex; flex-wrap: wrap; padding: 10rpx 20rpx; }
.goods-card { width: 345rpx; margin: 12rpx 10rpx; background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(255,122,69,.08); }
.goods-img { width: 100%; height: 345rpx; background: #f7f7f7; }
.goods-info { padding: 16rpx 20rpx 20rpx; }
.goods-title { font-size: 26rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-price { font-size: 32rpx; font-weight: 700; color: #FF6B35; margin-top: 8rpx; }
.goods-meta { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }
.load-more { text-align: center; color: #bbb; font-size: 24rpx; padding: 20rpx; }
