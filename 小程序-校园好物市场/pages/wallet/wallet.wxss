.page { padding-bottom: 40rpx; }
.bal-card { margin: 20rpx 24rpx; padding: 34rpx; border-radius: 24rpx; background: linear-gradient(135deg, #FF9A44, #FF6B35); color: #fff; display: flex; justify-content: space-between; align-items: center; }
.bal-label { font-size: 24rpx; opacity: .85; }
.bal-num { font-size: 52rpx; font-weight: 700; margin-top: 8rpx; }
.bal-btn { background: rgba(255,255,255,.25); color: #fff; font-size: 26rpx; padding: 4rpx 34rpx; border-radius: 999rpx; margin: 0; }
.flow { display: flex; justify-content: space-between; background: #fff; margin: 14rpx 24rpx 0; border-radius: 18rpx; padding: 22rpx 24rpx; }
.flow-type { font-size: 27rpx; font-weight: 600; color: #333; }
.flow-remark { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.flow-time { font-size: 20rpx; color: #ccc; margin-top: 6rpx; }
.flow-right { text-align: right; }
.flow-amount { font-size: 28rpx; font-weight: 700; }
.flow-bal { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 20; display: flex; align-items: center; justify-content: center; }
.re-modal { width: 84%; background: #fff; border-radius: 24rpx; padding: 36rpx; }
.rm-title { text-align: center; font-size: 32rpx; font-weight: 700; }
.rm-sub { text-align: center; font-size: 22rpx; color: #999; margin: 10rpx 0 24rpx; }
.rm-quick { display: flex; justify-content: center; gap: 14rpx; margin-bottom: 20rpx; }
.chip { padding: 10rpx 28rpx; background: #fff3ec; color: #FF7A45; border-radius: 999rpx; font-size: 25rpx; }
.rm-input { background: #f8f8f8; border-radius: 14rpx; padding: 20rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.rm-actions { display: flex; gap: 16rpx; }
.rm-btn { flex: 1; font-size: 28rpx; }
