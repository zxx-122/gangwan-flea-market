<view class="page">
  <view class="card block">
    <view class="label">商品图片（最多9张，首图为主图）</view>
    <view class="imgs">
      <view class="img-box" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="img-del" data-i="{{index}}" catchtap="removeImg">✕</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 9}}" bindtap="pickImage">＋</view>
    </view>
  </view>

  <view class="card block">
    <view class="label">商品标题 *</view>
    <input class="inp" placeholder="好标题能更快卖出" value="{{title}}" data-field="title" bindinput="onField" maxlength="100" />
    <view class="label">价格 (元) *</view>
    <input class="inp" type="digit" placeholder="0.00" value="{{price}}" data-field="price" bindinput="onField" />
    <view class="label">库存 <text class="sub">(售出自动减1，售罄自动下架)</text></view>
    <input class="inp" type="number" placeholder="1" value="{{stock}}" data-field="stock" bindinput="onField" />
    <view class="label">分类</view>
    <picker range="{{categories}}" range-key="name" bindchange="onPickCat">
      <view class="inp picker">{{selCatName || '请选择分类'}}</view>
    </picker>
    <view class="label">成色</view>
    <view class="conds">
      <view class="cond {{condition===c?'on':''}}" wx:for="{{conditions}}" wx:key="*this" data-i="{{index}}" bindtap="pickCondition">{{c}}</view>
    </view>
    <view class="price-ref" wx:if="{{priceRef}}">📊 该类目参考：均价 ¥{{priceRef.avg}}（{{priceRef.count}}件在售）</view>
    <view class="label">详细描述</view>
    <textarea class="ta" placeholder="品牌、入手时间、转手原因…" value="{{description}}" data-field="description" bindinput="onField" maxlength="1000" />
  </view>

  <button class="btn-primary submit" loading="{{submitting}}" bindtap="submit">{{editId ? '保存修改' : '确认发布'}}</button>
</view>
