.page { padding: 20rpx 24rpx 60rpx; }
.block { padding: 24rpx; margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: #666; margin: 16rpx 0 10rpx; }
.label .sub { color: #bbb; font-size: 22rpx; }
.inp { background: #f8f8f8; border-radius: 14rpx; padding: 18rpx 20rpx; font-size: 27rpx; }
.picker { color: #999; }
.conds { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cond { padding: 8rpx 24rpx; background: #f5f5f5; border-radius: 999rpx; font-size: 24rpx; color: #666; }
.cond.on { background: #fff3ec; color: #FF7A45; font-weight: 600; }
.price-ref { margin-top: 14rpx; font-size: 22rpx; color: #FF7A45; background: #fff7f2; border-radius: 10rpx; padding: 10rpx 16rpx; }
.ta { width: 100%; box-sizing: border-box; background: #f8f8f8; border-radius: 14rpx; padding: 18rpx 20rpx; font-size: 27rpx; min-height: 160rpx; }
.imgs { display: flex; flex-wrap: wrap; gap: 14rpx; }
.img-box { position: relative; width: 150rpx; height: 150rpx; }
.img-box image { width: 100%; height: 100%; border-radius: 12rpx; }
.img-del { position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; background: rgba(0,0,0,.6); color: #fff; border-radius: 50%; text-align: center; line-height: 36rpx; font-size: 24rpx; }
.img-add { width: 150rpx; height: 150rpx; border: 2rpx dashed #ddd; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #ccc; }
.submit { margin-top: 20rpx; }
