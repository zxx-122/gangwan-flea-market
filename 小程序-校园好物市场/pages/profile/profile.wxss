.page { padding-bottom: 60rpx; }
.head { display: flex; align-items: center; gap: 24rpx; padding: 50rpx 36rpx 30rpx; background: linear-gradient(135deg, #FF9A44, #FF7A45); color: #fff; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: rgba(255,255,255,.3); display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 700; }
.nick { font-size: 34rpx; font-weight: 700; }
.sub { font-size: 22rpx; opacity: .8; margin-top: 8rpx; }
.bal { margin-left: auto; font-size: 28rpx; background: rgba(255,255,255,.2); padding: 10rpx 26rpx; border-radius: 999rpx; }
.stat-row { display: flex; background: #fff; margin: -20rpx 24rpx 0; border-radius: 20rpx; padding: 26rpx 0; box-shadow: 0 6rpx 20rpx rgba(255,122,69,.10); position: relative; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 32rpx; font-weight: 700; color: #333; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.menu { background: #fff; margin: 20rpx 24rpx 0; border-radius: 20rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 28rpx 30rpx; border-bottom: 1rpx solid #f5f5f5; font-size: 28rpx; color: #333; }
.mi-icon { margin-right: 18rpx; }
.arrow { margin-left: auto; color: #ccc; }
.pwd-box { background: #fafafa; padding: 20rpx 30rpx; border-bottom: 1rpx solid #f5f5f5; }
.pwd-inp { background: #fff; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; margin-bottom: 14rpx; }
.pwd-save { font-size: 26rpx; padding: 4rpx 0; }
