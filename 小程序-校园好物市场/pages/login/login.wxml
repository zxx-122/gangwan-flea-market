<view class="login-page">
  <view class="logo-circle"><text class="logo-icon">🛍️</text></view>
  <view class="login-title">校园好物市场</view>
  <view class="login-sub">让闲置好物，遇见新主人</view>

  <view class="login-card">
    <view class="tabs">
      <view class="tab {{mode==='login'?'on':''}}" data-mode="login" bindtap="switchMode">账号登录</view>
      <view class="tab {{mode==='register'?'on':''}}" data-mode="register" bindtap="switchMode">注册账号</view>
    </view>
    <view class="field">
      <input placeholder="请输入账号" value="{{username}}" data-field="username" bindinput="onInput" maxlength="20" />
    </view>
    <view class="field">
      <input placeholder="请输入密码" password value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
    <view class="field" wx:if="{{mode==='register'}}">
      <input placeholder="昵称（选填）" value="{{nickname}}" data-field="nickname" bindinput="onInput" maxlength="20" />
    </view>
    <button class="btn-primary submit" loading="{{submitting}}" bindtap="submit">{{mode==='login' ? '登 录' : '注 册'}}</button>
    <view class="hint">注册即送 1000 体验金 · 与网页版账号互通</view>
  </view>
</view>
