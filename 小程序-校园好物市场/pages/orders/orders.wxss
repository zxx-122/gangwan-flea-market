.page { padding: 20rpx 24rpx 40rpx; }
.order-card { background: #fff; border-radius: 20rpx; padding: 22rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(255,122,69,.08); }
.o-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.o-no { font-size: 22rpx; color: #bbb; }
.o-status { font-size: 24rpx; font-weight: 600; }
.s-待发货 { color: #FF7A45; }
.s-待收货 { color: #3498DB; }
.s-已完成 { color: #2ECC71; }
.s-已取消 { color: #bbb; }
.o-body { display: flex; gap: 16rpx; }
.o-img { width: 140rpx; height: 140rpx; border-radius: 14rpx; background: #f7f7f7; flex-shrink: 0; }
.o-info { flex: 1; }
.o-title { font-size: 27rpx; color: #333; }
.o-price { font-size: 30rpx; margin-top: 10rpx; }
.logi { margin-top: 16rpx; background: #ebf5fb; border: 1rpx solid #d6eaf8; color: #2c6aa0; border-radius: 12rpx; padding: 12rpx 18rpx; font-size: 23rpx; }
.o-actions { display: flex; justify-content: flex-end; align-items: center; gap: 14rpx; margin-top: 18rpx; }
.mini { font-size: 24rpx; padding: 6rpx 26rpx; margin: 0; line-height: 2; }
.paid { font-size: 22rpx; color: #999; }
