<view class="page">
  <view class="empty" wx:if="{{loading}}">加载中...</view>
  <view class="empty" wx:elif="{{!list.length}}">还没有收藏商品</view>
  <view class="fav-card" wx:for="{{list}}" wx:key="id">
    <view class="fav-body" bindtap="goDetail" data-id="{{item.id}}">
      <image class="fav-img" src="{{item.img}}" mode="aspectFill" lazy-load />
      <view class="fav-info">
        <view class="fav-title">{{item.title}}</view>
        <view class="fav-price price">¥{{item.priceTxt}}</view>
        <text class="tag">{{item.status}}</text>
      </view>
      <view class="fav-del" data-id="{{item.id}}" catchtap="removeFav">❤️</view>
    </view>
  </view>
</view>
