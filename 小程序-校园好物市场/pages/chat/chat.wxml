<view class="chat-room">
  <scroll-view scroll-y class="msgs" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-row {{item.self ? 'self' : ''}}">
      <view class="bubble {{item.self ? 'bub-self' : 'bub-other'}}">{{item.content}}</view>
      <view class="msg-time">{{item.time}}</view>
    </view>
    <view class="empty" wx:if="{{!messages.length}}">发送一条消息开始对话吧</view>
    <view style="height: 20rpx;"></view>
  </scroll-view>
  <view class="quick-row">
    <text class="quick-chip" wx:for="{{quick}}" wx:key="*this" data-q="{{item}}" bindtap="useQuick">{{item}}</text>
  </view>
  <view class="input-bar">
    <input class="chat-inp" value="{{text}}" bindinput="onInput" bindconfirm="send" confirm-type="send" placeholder="输入消息..." />
    <view class="send-btn" bindtap="send">发送</view>
  </view>
</view>
